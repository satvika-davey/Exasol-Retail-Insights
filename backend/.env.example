# Exasol SaaS trial connection (from cloud.exasol.com after you create
# a database — NOT the static public-demo system, which won't let you
# load your own data).
EXASOL_HOST=your-database-hostname.clusters.exasol.com
EXASOL_PORT=8563
EXASOL_USER=your_trial_username
EXASOL_PASSWORD=your_trial_password
EXASOL_SCHEMA=RETAIL

# Which LLM provider llm_client.py should use: groq / openai / anthropic
LLM_PROVIDER=groq
GROQ_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here
